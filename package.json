{
  "name": "pricewatch-agent",
  "version": "0.1.2",
  "description": "AI-powered price watcher: scrapes any shop page, extracts price and stock with Claude, alerts on change",
  "scripts": {
    "test": "vitest run",
    "pricewatch": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "watch": "tsx src/cli.ts watch",
    "typecheck": "tsc --noEmit",
    "evals": "tsx evals/run.ts",
    "evals:capture": "tsx evals/capture.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "prepack": "npm run build"
  },
  "keywords": [
    "price-tracker",
    "web-scraping",
    "playwright",
    "anthropic",
    "claude",
    "structured-outputs",
    "sqlite",
    "discord"
  ],
  "author": "Rafał Branc (https://ravdev.pl)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pricewatch": "./bin/pricewatch.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brancuuuu/pricewatch-agent.git"
  },
  "homepage": "https://github.com/Brancuuuu/pricewatch-agent#readme",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ]
}
