# Copy to .env and fill in. Never commit .env.

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Model used for extraction. Haiku is the cheapest and is enough for this task.
PRICEWATCH_MODEL=claude-haiku-4-5-20251001

# Optional: Discord webhook that receives price-change alerts
DISCORD_WEBHOOK_URL=

# SQLite file with products and price history
PRICEWATCH_DB=./data/pricewatch.db

# HTTP dashboard port
PORT=8790

# Minutes between checks when running `pricewatch watch`
WATCH_INTERVAL_MINUTES=60
